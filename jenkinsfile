
pipeline {
    agent any

    stages {
        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'
                    withSonarQubeEnv('SonarQube') {
                        sh """
                            "${scannerHome}/bin/sonar-scanner" \
                      -Dsonar.projectKey=media-manager \
                      -Dsonar.projectName="Media Manager" \
                      -Dsonar.sources=backend,frontend \
                      -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Trivy Security Scan') {
            steps {
                sh '''
                    trivy fs \
                      --scanners vuln,secret \
                      --severity HIGH,CRITICAL \
                      .
                '''
            }
        }

        
stage('ECR Login') {
    steps {
        sh '''
            aws ecr get-login-password --region ap-south-1 |
            docker login \
              --username AWS \
              --password-stdin \
              059310318163.dkr.ecr.ap-south-1.amazonaws.com
        '''
    }
}

stage('Build and Push Backend') {
    steps {
        sh '''
            docker build \
              -t 059310318163.dkr.ecr.ap-south-1.amazonaws.com/media-manager-backend:${BUILD_NUMBER} \
              -t 059310318163.dkr.ecr.ap-south-1.amazonaws.com/media-manager-backend:latest \
              ./backend

            docker push 059310318163.dkr.ecr.ap-south-1.amazonaws.com/media-manager-backend:${BUILD_NUMBER}
            docker push 059310318163.dkr.ecr.ap-south-1.amazonaws.com/media-manager-backend:latest
        '''
    }
}

stage('Build and Push Frontend') {
    steps {
        sh '''
            docker build \
              -t 059310318163.dkr.ecr.ap-south-1.amazonaws.com/media-manager-frontend:${BUILD_NUMBER} \
              -t 059310318163.dkr.ecr.ap-south-1.amazonaws.com/media-manager-frontend:latest \
              ./frontend

            docker push 059310318163.dkr.ecr.ap-south-1.amazonaws.com/media-manager-frontend:${BUILD_NUMBER}
            docker push 059310318163.dkr.ecr.ap-south-1.amazonaws.com/media-manager-frontend:latest
        '''
    }
}


    }

    post {
        success {
            echo 'SonarQube analysis and Trivy scan passed!'
        }
        failure {
            echo 'Pipeline failed. Check the stage console output.'
        }
    }
}
